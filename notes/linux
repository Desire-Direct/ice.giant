# GIT 
git config --list	#check configuration settings (.gitconfig)

#user permissions
ls -l	#display permissions
sudo chown -R username:usergroup directory	#change permission for dir and contents

# mount encrypted partition
sudo cryptsetup --type luks open /dev/sdX crypt
sudo mount -t ext4 /dev/mapper/crypt /mnt/myusb

# unmount encrypted partition
sudo umount /mnt/myusb
sudo cryptsetup close crypt

# rsync
# -P stands for show progress
sudo rsync -r -P source destination

